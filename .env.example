# Hostinger serves the domain root. The Pages workflow overrides this value.
NEXT_PUBLIC_BASE_PATH=

# Existing measurement ID verified on olemanrb.com on September 18, 2026.
# Analytics only initializes on the live domain, never on previews or localhost.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-MGZGBR196N

# The Hostinger WordPress bridge preserves the existing Elementor/Make workflow.
NEXT_PUBLIC_QUOTE_ENDPOINT=/wp-json/modern-apex/v1/quote
